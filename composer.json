{
    "name": "smepay/smepay-php",
    "description": "Official PHP SDK for the SMEPay External API (UPI payments).",
    "type": "library",
    "keywords": ["smepay", "upi", "payments", "payment-gateway", "india", "sdk"],
    "homepage": "https://github.com/Typof-Technologies-Pvt-Ltd/smepay-php",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/Typof-Technologies-Pvt-Ltd/smepay-php/issues",
        "source": "https://github.com/Typof-Technologies-Pvt-Ltd/smepay-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "SMEPay\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "analyse": "phpstan analyse"
    }
}
